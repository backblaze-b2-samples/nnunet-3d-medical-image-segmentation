# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
dist/
build/

# Next.js 16 `next dev` auto-generates per-app agent instruction files in the web
# app dir on every boot (apps/web/AGENTS.md + its CLAUDE.md shim, pointing at
# node_modules internals). They duplicate the single-source root AGENTS.md map, so
# keep them out of the tree — `next dev` recreates them locally as needed.
apps/web/AGENTS.md
apps/web/CLAUDE.md
apps/web/GEMINI.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Environment
# Real env files are never tracked; example/template files always are.
# Negations must stay after the ignore patterns above them to take effect.
.env
.env.*
!.env*.example
!.env*.template

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.pytest_cache/
playwright-report/
test-results/

# B2 / AWS
.aws/

# Local runtime data (download counter, etc.). Deliberately at the repo root and
# NOT under services/api/ — that directory is what `uvicorn --reload` watches, so
# runtime writes there make the dev reloader report changes on every download.
.data/
# Legacy location, still ignored for clones that already have it.
services/api/data/

# Local-only working area (machine/user-specific)
.local/

# Vercel CLI local link state (project IDs, pulled env). Never commit it.
.vercel
